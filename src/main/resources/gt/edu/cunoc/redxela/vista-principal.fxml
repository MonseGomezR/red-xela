<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gt.edu.cunoc.redxela.controlador.VistaPrincipalController" stylesheets="@estilos.css">
 <left><VBox prefWidth="256" minWidth="256" maxWidth="256" spacing="6" styleClass="lateral">
  <HBox spacing="12" alignment="CENTER_LEFT" styleClass="marca-contenedor">
   <Label styleClass="logo"><graphic><FontIcon iconLiteral="fth-package" iconSize="24"/></graphic></Label>
   <HBox><Label text="RED" styleClass="marca"/><Label text="Xela" styleClass="marca-cian"/></HBox>
  </HBox>
  <Button fx:id="navMonitoreo" text="Monitoreo" onAction="#monitorear" maxWidth="Infinity" styleClass="nav"><graphic><FontIcon iconLiteral="fth-activity" iconSize="19"/></graphic></Button>
  <Button fx:id="navPedidos" text="Pedidos" onAction="#nuevoPedido" maxWidth="Infinity" styleClass="nav"><graphic><FontIcon iconLiteral="fth-shopping-cart" iconSize="19"/></graphic></Button>
  <VBox spacing="2" styleClass="submenu">
   <Button fx:id="subNuevo" text="Nuevo pedido" onAction="#nuevoPedido" maxWidth="Infinity" styleClass="nav,subnav"/>
   <Button fx:id="subClientes" text="Cuentas de clientes" onAction="#gestionarClientes" maxWidth="Infinity" styleClass="nav,subnav"/>
   <Button fx:id="subHistorial" text="Historial de pedidos" onAction="#historial" maxWidth="Infinity" styleClass="nav,subnav"/>
  </VBox>
  <Button fx:id="navInventario" text="Inventario" onAction="#almacenar" maxWidth="Infinity" styleClass="nav"><graphic><FontIcon iconLiteral="fth-archive" iconSize="19"/></graphic></Button>
  <VBox spacing="2" styleClass="submenu">
   <Button fx:id="subMapa" text="Almacén y existencias" onAction="#almacenar" maxWidth="Infinity" styleClass="nav,subnav"/>
   <Button fx:id="subRecepcion" text="Recibir mercadería" onAction="#recepcionar" maxWidth="Infinity" styleClass="nav,subnav"/>
  </VBox>
  <Button fx:id="navAdmin" text="Conflictos" onAction="#administrar" maxWidth="Infinity" styleClass="nav"><graphic><FontIcon iconLiteral="fth-alert-triangle" iconSize="19"/></graphic></Button>
  <VBox spacing="2" styleClass="submenu">
   <Button fx:id="subConflictos" text="Resolución de conflictos" onAction="#administrar" maxWidth="Infinity" styleClass="nav,subnav"/>
   <Button fx:id="subDepurar" text="Depuración" onAction="#depurar" maxWidth="Infinity" styleClass="nav,subnav"/>
  </VBox>
  <Region VBox.vgrow="ALWAYS"/>
  <HBox spacing="12" alignment="CENTER_LEFT" styleClass="identidad"><Label styleClass="avatar"><graphic><FontIcon iconLiteral="fth-user" iconSize="26"/></graphic></Label><VBox spacing="4"><Label text="Sesión local" styleClass="destacado"/><Label text="SIMULADOR" styleClass="etiqueta"/></VBox></HBox>
 </VBox></left>
 <center><BorderPane>
  <top><HBox alignment="CENTER_LEFT" spacing="20" styleClass="barra-superior">
   <Label fx:id="titulo" minWidth="0" styleClass="titulo-ventana"/>
   <Label fx:id="estado" styleClass="estado-sesion"><graphic><FontIcon iconLiteral="fth-circle" iconSize="8"/></graphic></Label>
   <Region HBox.hgrow="ALWAYS"/>
   <HBox fx:id="controlesMonitoreo" spacing="10" alignment="CENTER_LEFT">
    <Button fx:id="iniciar" onAction="#reanudar" styleClass="control-simulacion"><graphic><FontIcon iconLiteral="fth-play" iconSize="17"/></graphic><tooltip><Tooltip text="Iniciar o reanudar"/></tooltip></Button>
    <Button fx:id="pausar" onAction="#pausar" styleClass="control-simulacion"><graphic><FontIcon iconLiteral="fth-pause" iconSize="17"/></graphic><tooltip><Tooltip text="Pausar"/></tooltip></Button>
    <Button fx:id="avanzar" onAction="#paso" styleClass="control-simulacion"><graphic><FontIcon iconLiteral="fth-skip-forward" iconSize="17"/></graphic><tooltip><Tooltip text="Avanzar un minuto en pausa"/></tooltip></Button>
    <Label text="Velocidad:" styleClass="muted"/><ComboBox fx:id="velocidad" prefWidth="85"/>
   </HBox>
   <HBox fx:id="controlesInventario" spacing="12" alignment="CENTER_LEFT"/>
   <HBox fx:id="controlesAdmin" spacing="0" alignment="CENTER_LEFT"><Label text="Simulación:   " styleClass="muted"/><ToggleButton fx:id="estandar" text="ESTÁNDAR" onAction="#modoEstandar"/><ToggleButton fx:id="estres" text="STRESS TEST" onAction="#modoEstres"/></HBox>
  </HBox></top>
  <center><ScrollPane fx:id="contenido" fitToWidth="true" hbarPolicy="NEVER" pannable="true"/></center>
  <bottom><HBox alignment="CENTER_LEFT" spacing="12" styleClass="barra-inferior">
   <Label fx:id="pie" text="CAPACIDAD ALMACÉN:" styleClass="etiqueta"/><ProgressBar fx:id="barraCapacidad" prefWidth="92"/><Label fx:id="capacidad" styleClass="dato-cian"/>
   <Label fx:id="entorno" styleClass="etiqueta"/><Label fx:id="aviso" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/>
   <Label text="USAC, SISTEMAS OPERATIVOS 2" styleClass="dato-cian"/>
  </HBox></bottom>
 </BorderPane></center>
</BorderPane>
