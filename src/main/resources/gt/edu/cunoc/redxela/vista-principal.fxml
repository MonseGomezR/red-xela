<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gt.edu.cunoc.redxela.controlador.VistaPrincipalController" stylesheets="@estilos.css">
    <left>
        <VBox prefWidth="226" minWidth="226" maxWidth="226" spacing="12" styleClass="lateral">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="marca-contenedor">
                <Label text="▦" styleClass="logo"/>
                <HBox alignment="CENTER_LEFT"><Label text="RED" styleClass="marca"/><Label text="Xela" styleClass="marca-cian"/></HBox>
            </HBox>
            <Button fx:id="navMonitoreo" text="⌁   Monitoreo en vivo" onAction="#monitorear" maxWidth="Infinity" styleClass="nav"/>
            <Button fx:id="navInventario" text="▦   Inventario &amp; stock" onAction="#almacenar" maxWidth="Infinity" styleClass="nav"/>
            <Button fx:id="navAdmin" text="⚠   Conflictos (deadlocks)" onAction="#administrar" maxWidth="Infinity" wrapText="true" styleClass="nav"/>
            <Button text="◷   Historial de pedidos" onAction="#historial" maxWidth="Infinity" styleClass="nav"/>
            <Label text="SIMULACIÓN" styleClass="grupo-nav"/>
            <Button text="⊕   Nuevo pedido manual" onAction="#administrar" maxWidth="Infinity" wrapText="true" styleClass="nav"/>
            <Button text="↳   Ingresar mercadería" onAction="#recepcionar" maxWidth="Infinity" styleClass="nav"/>
            <Label text="HERRAMIENTAS" styleClass="grupo-nav"/>
            <Button text="⌘   Modo depuración" onAction="#depurar" maxWidth="Infinity" styleClass="nav"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="7" styleClass="identidad">
                <Label text="USAC / CUNOC" styleClass="dato-cian"/>
                <Label text="Universidad de San Carlos de Guatemala" wrapText="true" styleClass="institucion"/>
                <Label text="ADMINISTRACIÓN · SO2" styleClass="etiqueta"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="barra-superior">
                    <Label fx:id="titulo" text="Panel de Control General" minWidth="0" styleClass="titulo-ventana"/>
                    <Label fx:id="estado" text="● SIMULACIÓN PAUSADA" styleClass="estado-sesion"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="iniciar" text="▶" onAction="#alternar" styleClass="control-simulacion"/>
                    <Button text="▸|" onAction="#paso" styleClass="control-simulacion"><tooltip><Tooltip text="Avanzar un minuto simulado en pausa"/></tooltip></Button>
                    <Label text="Velocidad:" styleClass="muted"/>
                    <ComboBox fx:id="velocidad" prefWidth="85"/>
                </HBox>
            </top>
            <center><ScrollPane fx:id="contenido" fitToWidth="true" hbarPolicy="NEVER" pannable="true"/></center>
            <bottom>
                <VBox spacing="4" styleClass="barra-inferior">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="CAPACIDAD ALMACÉN:" styleClass="etiqueta"/>
                        <ProgressBar fx:id="barraCapacidad" prefWidth="105" progress="0"/>
                        <Label fx:id="capacidad" text="0%" styleClass="dato-cian"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="SISTEMAS OPERATIVOS 2" styleClass="dato-cian"/>
                        <Label text="2026" styleClass="etiqueta"/>
                    </HBox>
                    <HBox spacing="15"><Label fx:id="entorno" styleClass="etiqueta"/><Label fx:id="aviso" styleClass="muted"/></HBox>
                </VBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
